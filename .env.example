# Copy this file to `.env` and fill in the values:
#
#     cp .env.example .env
#
# `.env` is gitignored and holds real credentials. This file is the
# template, carries no secrets, and IS tracked — keep it that way, and
# keep the two in step when a variable is added.

# -- required ----------------------------------------------------------

# Extraction defaults to an OpenAI model (ADR-031), while the agent loop
# and the LangGraph port call Anthropic. Both are needed for a full run;
# neither appears in a getenv() call because each SDK reads its own key
# from the environment.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# -- optional ----------------------------------------------------------

# Where chat.py looks for the service. Defaults to the loopback address
# below if unset, which is the only address server.py binds (ADR-020).
# The seam exists for pointing the REPL at a different port.
#SECRETARY_URL=http://127.0.0.1:8765
